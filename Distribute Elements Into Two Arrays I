class Solution {
    public int[] resultArray(int[] nums) {
        List<Integer> a = new ArrayList<>();
        List<Integer> b = new ArrayList<>();

        a.add(nums[0]);
        b.add(nums[1]);

        for (int i = 2; i < nums.length; i++) {
            if (a.get(a.size() - 1) > b.get(b.size() - 1)) {
                a.add(nums[i]);
            } else {
                b.add(nums[i]);
            }
        }

        int[] result = new int[nums.length];
        int index = 0;

        for (int num : a) {
            result[index++] = num;
        }

        for (int num : b) {
            result[index++] = num;
        }

        return result;
    }
}

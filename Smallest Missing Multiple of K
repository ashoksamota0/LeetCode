import java.util.*;

class Solution {
    public int missingMultiple(int[] nums, int k) {
        Set<Integer> set = new HashSet<>();

        for (int num : nums) {
            if (num % k == 0) {
                set.add(num);
            }
        }

        int x = k;

        while (set.contains(x)) {
            x += k;
        }

        return x;
    }
}

class Solution {
    private int[] prefix;
    private int[][] dp;
    private int[] stones;

    public int stoneGameV(int[] stoneValue) {
        int n = stoneValue.length;

        stones = stoneValue;
        prefix = new int[n + 1];
        dp = new int[n][n];

        for (int i = 0; i < n; i++) {
            prefix[i + 1] = prefix[i] + stoneValue[i];
        }

        return dfs(0, n - 1);
    }

    private int dfs(int left, int right) {
        if (left >= right) {
            return 0;
        }

        if (dp[left][right] != 0) {
            return dp[left][right];
        }

        int ans = 0;
        int sumLeft = 0;
        int sumRight = prefix[right + 1] - prefix[left];

        for (int k = left; k < right; k++) {
            sumLeft += stones[k];
            sumRight -= stones[k];

            if (sumLeft < sumRight) {
                if (ans >= 2 * sumLeft) {
                    continue;
                }

                ans = Math.max(ans, sumLeft + dfs(left, k));
            } else if (sumLeft > sumRight) {
                if (ans >= 2 * sumRight) {
                    break;
                }

                ans = Math.max(ans, sumRight + dfs(k + 1, right));
            } else {
                ans = Math.max(ans,
                        Math.max(
                                sumLeft + dfs(left, k),
                                sumRight + dfs(k + 1, right)
                        ));
            }
        }

        return dp[left][right] = ans;
    }
}

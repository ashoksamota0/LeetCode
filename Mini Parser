class Solution {
    public NestedInteger deserialize(String s) {
        if (s.charAt(0) != '[') {
            return new NestedInteger(Integer.parseInt(s));
        }

        Stack<NestedInteger> stack = new Stack<>();
        NestedInteger current = null;
        int num = 0;
        int sign = 1;
        boolean readingNum = false;

        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);

            if (c == '[') {
                NestedInteger list = new NestedInteger();
                stack.push(list);
            } else if (c == '-' ) {
                sign = -1;
            } else if (Character.isDigit(c)) {
                num = num * 10 + (c - '0');
                readingNum = true;
            } else {
                if (readingNum) {
                    stack.peek().add(new NestedInteger(num * sign));
                    num = 0;
                    sign = 1;
                    readingNum = false;
                }

                if (c == ']') {
                    current = stack.pop();

                    if (!stack.isEmpty()) {
                        stack.peek().add(current);
                    }
                }
            }
        }

        return current;
    }
}

class Solution {
    static class Trie {
        Trie[] child = new Trie[2];
    }

    public int findMaximumXOR(int[] nums) {
        Trie root = new Trie();
        int answer = 0;

        for (int num : nums) {
            insert(root, num);
        }

        for (int num : nums) {
            Trie node = root;
            int xor = 0;

            for (int bit = 30; bit >= 0; bit--) {
                int b = (num >> bit) & 1;

                if (node.child[1 - b] != null) {
                    xor |= (1 << bit);
                    node = node.child[1 - b];
                } else {
                    node = node.child[b];
                }
            }

            answer = Math.max(answer, xor);
        }

        return answer;
    }

    private void insert(Trie root, int num) {
        Trie node = root;

        for (int bit = 30; bit >= 0; bit--) {
            int b = (num >> bit) & 1;

            if (node.child[b] == null) {
                node.child[b] = new Trie();
            }

            node = node.child[b];
        }
    }
}

class Solution {
    private final String[] below20 = {
        "", "One", "Two", "Three", "Four", "Five", "Six", "Seven",
        "Eight", "Nine", "Ten", "Eleven", "Twelve", "Thirteen",
        "Fourteen", "Fifteen", "Sixteen", "Seventeen", "Eighteen", "Nineteen"
    };

    private final String[] tens = {
        "", "", "Twenty", "Thirty", "Forty", "Fifty",
        "Sixty", "Seventy", "Eighty", "Ninety"
    };

    public String numberToWords(int num) {
        if (num == 0) {
            return "Zero";
        }

        StringBuilder sb = new StringBuilder();

        convert(num, sb);

        return sb.toString();
    }

    private void convert(int num, StringBuilder sb) {
        if (num >= 1_000_000_000) {
            convert(num / 1_000_000_000, sb);
            sb.append(" Billion");
            num %= 1_000_000_000;
            if (num > 0) sb.append(" ");
        }

        if (num >= 1_000_000) {
            convert(num / 1_000_000, sb);
            sb.append(" Million");
            num %= 1_000_000;
            if (num > 0) sb.append(" ");
        }

        if (num >= 1000) {
            convert(num / 1000, sb);
            sb.append(" Thousand");
            num %= 1000;
            if (num > 0) sb.append(" ");
        }

        if (num >= 100) {
            convert(num / 100, sb);
            sb.append(" Hundred");
            num %= 100;
            if (num > 0) sb.append(" ");
        }

        if (num >= 20) {
            sb.append(tens[num / 10]);
            num %= 10;

            if (num > 0) {
                sb.append(" ");
            }
        }

        if (num > 0) {
            sb.append(below20[num]);
        }
    }
}
